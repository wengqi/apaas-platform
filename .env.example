# ============================================================================
# aPaaS 低代码平台 — 环境变量示例
# 复制为 .env 并填入实际值。仅后端服务读取这些变量（前端通过 VITE_ 前缀读取）。
# ============================================================================

# ---- 运行环境 ----
NODE_ENV=development

# ---- PostgreSQL (元数据 + 运行时库) ----
DATABASE_URL="postgresql://apaas:apaas@localhost:5432/apaas?schema=public"

# ---- Redis (缓存 + 流程队列) ----
REDIS_URL="redis://localhost:6379"

# ---- 认证 (JWT) ----
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ---- 流程引擎 (自研，基于 BullMQ 异步执行) ----
# 自研流程引擎使用 BullMQ 队列，无需额外服务

# ---- 服务端口 ----
GATEWAY_PORT=3000
META_SVC_PORT=3001
RUNTIME_SVC_PORT=3002
PROCESS_SVC_PORT=3003

# ---- 前端 ----
VITE_STUDIO_PORT=5173
VITE_RUNTIME_PORT=5174
VITE_API_BASE_URL="http://localhost:3000"
