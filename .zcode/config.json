{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${ZCODE_PROJECT_DIR}/scripts/zcode-hooks/guard.sh\"",
              "timeout": 10,
              "statusMessage": "危险命令检查"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Edit|Write",
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${ZCODE_PROJECT_DIR}/scripts/zcode-hooks/format.sh\"",
              "timeout": 30,
              "statusMessage": "格式化改动文件"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "cd \"${ZCODE_PROJECT_DIR}\" && pnpm typecheck || exit 2",
              "timeout": 300,
              "statusMessage": "收尾 typecheck"
            }
          ]
        }
      ]
    }
  }
}
