// ============================================================================
// aPaaS 低代码平台 — Prisma Schema (Phase 0 基础层)
//
// 设计原则（与 ARCHITECTURE.md 对齐）：
//  1. 元数据驱动：objects/fields/views/pages/processes 存元数据 JSON
//  2. JSONB 宽表：所有业务记录统一存 records 表，object_id + data JSONB + GIN
//  3. 多租户：tenant_id 行级隔离（生产期叠加 PostgreSQL RLS）
//  4. 流程引擎：process_definitions 存 WorkflowSchema JSON（SSOT），自研引擎直接消费
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 一、系统基础：租户 / 用户 / 角色 / 组织
// ============================================================================

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique // 租户短标识，用于 URL 路由
  description String? // 租户描述
  status      TenantStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  users                 User[]
  roles                 Role[]
  orgNodes              OrgNode[]
  applications          Application[]
  objects               ObjectMeta[]
  pages                 PageMeta[]
  pageSavePoints        PageSavePoint[]
  processes             ProcessDef[]
  records               Record[]
  permissionRules       PermissionRule[]
  orgRoleGrants         OrgRoleGrant[]
  auditLogs             AuditLog[]
  appVersions           AppVersion[]
  resourceVersions      ResourceVersion[]
  appEnvironments       AppEnvironment[]
  deployments           Deployment[]
  envVarDefs            EnvVarDef[]
  envVarValues          EnvVarValue[]
  changeLogs            ChangeLog[]
  appChecks             AppCheck[]
  inAppMessages         InAppMessage[]
  connectors            Connector[]
  connectorCredentials  ConnectorCredential[]
  datasets              Dataset[]
  dataFlows             DataFlow[]
  cloudFunctions        CloudFunction[]
  notificationTemplates NotificationTemplate[]
  autoNumberCounters    AutoNumberCounter[]
  userIdentities        UserIdentity[]
  integrationConfigs    IntegrationConfig[]
  directorySyncLogs     DirectorySyncLog[]

  @@map("tenants")
}

// ----------------------------------------------------------------------------
// 一·十一、企业身份对接 (Identity Integration) — CAS/LDAP/人力主数据适配层
// ----------------------------------------------------------------------------

/// 外部身份 ↔ 平台用户绑定（一人可绑多源：cas / ldap / hr-api / feishu）
/// externalId 为源系统全局唯一键（CAS username / LDAP 工号 employeeNumber / entryUUID）
model UserIdentity {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  userId     String    @map("user_id")
  provider   String // cas | ldap | hr-api | feishu
  externalId String    @map("external_id")
  lastSyncAt DateTime? @map("last_sync_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, externalId])
  @@index([tenantId])
  @@index([userId])
  @@map("user_identities")
}

/// 租户级对接配置（kind=auth-provider|directory-source；type=cas|ldap|hr-api|feishu）
/// config 内敏感字段（bindPassword/headers 等）以 AES-256-GCM 加密存储（复用连接器加密工具）
model IntegrationConfig {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  kind      String
  type      String
  config    Json     @default("{}")
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, type])
  @@index([tenantId])
  @@map("integration_configs")
}

/// 目录同步审计日志（全量/diff 统计、冲突、错误）
model DirectorySyncLog {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  source    String // ldap | hr-api
  status    String // success | error
  stats     Json     @default("{}")
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("directory_sync_logs")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

// ============================================================================
// 一·二、应用 (Application) — 顶层业务容器
// ============================================================================

model Application {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  apiName           String    @map("api_name") // 开发者标识，如 "asset_management"
  name              String // 显示名
  description       String?
  icon              String?
  color             String? // 主题色
  status            AppStatus @default(DRAFT)
  version           Int       @default(0) // 发布版本号，每次发布递增
  // 已发布的应用快照 JSON（含对象/页面/流程定义的完整副本）
  publishedSnapshot Json?     @map("published_snapshot")
  publishedAt       DateTime? @map("published_at")
  createdBy         String    @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  objects               ObjectMeta[]
  pages                 PageMeta[]
  processes             ProcessDef[]
  records               Record[]
  roles                 Role[]
  versions              AppVersion[]
  resourceVersions      ResourceVersion[]
  environments          AppEnvironment[]
  deployments           Deployment[]
  envVarDefs            EnvVarDef[]
  changeLogs            ChangeLog[]
  checks                AppCheck[]
  connectors            Connector[]
  connectorCredentials  ConnectorCredential[]
  datasets              Dataset[]
  dataFlows             DataFlow[]
  cloudFunctions        CloudFunction[]
  notificationTemplates NotificationTemplate[]

  @@unique([tenantId, apiName])
  @@index([tenantId])
  @@map("applications")
}

enum AppStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                  String     @id @default(cuid())
  tenantId            String?    @map("tenant_id") // null = 平台超管（跨租户）
  email               String
  name                String
  avatar              String?
  passwordHash        String     @map("password_hash") // bcrypt
  isPlatformAdmin     Boolean    @default(false) @map("is_platform_admin") // 平台超管标识
  status              UserStatus @default(ACTIVE)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts") // 登录失败计数（评审 H-2 防爆破）
  lockedUntil         DateTime?  @map("locked_until") // 账号锁定截止时间
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles      UserRole[]
  orgMemberships OrgMember[]
  cloudFunctions CloudFunction[]
  identities     UserIdentity[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([isPlatformAdmin])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  appId       String?  @map("app_id") // 为空=租户级角色，非空=应用级角色
  name        String
  code        String // 角色编码，如 ADMIN / BUILDER / END_USER
  description String?
  isBuiltIn   Boolean  @default(false) @map("is_built_in")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application     Application?     @relation(fields: [appId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  permissionRules PermissionRule[]
  orgRoleGrants   OrgRoleGrant[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([appId])
  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model OrgNode {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  parentId  String?  @map("parent_id")
  name      String
  code      String
  nodeType  String   @default("DEPARTMENT") @map("node_type") // DEPARTMENT | TEAM | POSITION
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent        OrgNode?       @relation("OrgTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      OrgNode[]      @relation("OrgTree")
  memberships   OrgMember[]
  orgRoleGrants OrgRoleGrant[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
  @@map("org_nodes")
}

model OrgMember {
  userId   String   @map("user_id")
  orgId    String   @map("org_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  OrgNode @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([userId, orgId])
  @@index([orgId])
  @@map("org_members")
}

// ----------------------------------------------------------------------------
// 一·四、权限规则 (PermissionRule) — 五级权限核心配置实体
// ----------------------------------------------------------------------------

/// 权限规则 — 声明某角色对某资源有何动作权限，是否附带行级条件。
/// RBAC + ABAC 混合模型：角色判定有无权限(RBAC)，条件表达式过滤可见数据(ABAC)。
model PermissionRule {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  appId        String?  @map("app_id") // 空=租户级规则；非空=应用级规则
  roleId       String   @map("role_id")
  // 权限维度（五级）
  type         String   @map("type") // PAGE | RECORD | PROCESS | DATA_MODEL | CONNECTOR
  // 权限动作
  action       String   @map("action") // VIEW | CREATE | EDIT | DELETE | EXECUTE | APPROVE | MANAGE
  // 作用目标
  targetId     String   @map("target_id") // 页面ID / 对象ID / 流程定义ID / 连接器ID
  targetNodeId String?  @map("target_node_id") // 流程节点ID（仅 PROCESS:APPROVE 用）
  // 行级条件（仅 RECORD 类型用，JSON 条件表达式）
  condition    Json?    @map("condition") // 条件表达式 JSON，null=无条件
  // 字段级范围（仅 DATA_MODEL 类型用）
  fieldScope   Json?    @map("field_scope") // string[] 白名单字段，null=全部字段
  // 权限效果
  effect       String   @default("ALLOW") @map("effect") // ALLOW | DENY
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([roleId])
  @@index([tenantId, type, targetId])
  @@index([appId, type, targetId])
  @@map("permission_rules")
}

// ----------------------------------------------------------------------------
// 一·五、组织角色授权 (OrgRoleGrant) — 将角色授权给组织节点
// ----------------------------------------------------------------------------

/// 组织角色授权 — 将角色授权给组织节点，节点下所有成员自动获得该角色。
model OrgRoleGrant {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  orgId     String   @map("org_id")
  roleId    String   @map("role_id")
  appId     String?  @map("app_id") // 应用级角色需指定应用
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orgNode OrgNode @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([orgId, roleId, appId])
  @@index([tenantId])
  @@index([orgId])
  @@map("org_role_grants")
}

// ----------------------------------------------------------------------------
// 一·六、审计日志 (AuditLog) — 权限操作审计
// ----------------------------------------------------------------------------

/// 审计日志 — 记录权限变更、敏感操作等审计事件。
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  userId     String   @map("user_id")
  // 应用维度（ROADMAP 9.9 应用级审计 UI）：平台级事件为空
  appId      String?  @map("app_id")
  action     String // CREATE_ROLE | UPDATE_PERMISSION | DELETE_USER | ...
  resource   String? // 操作资源类型
  resourceId String?  @map("resource_id") // 资源 ID
  detail     Json? // 操作详情 JSON
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, action])
  @@index([tenantId, appId])
  @@map("audit_logs")
}

// ============================================================================
// 二、对象/数据建模（元数据 + JSONB 宽表存储）
// ============================================================================

model ObjectMeta {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  appId       String   @map("app_id")
  apiName     String   @map("api_name") // 开发者标识，如 "asset"
  name        String // 显示名
  description String?
  icon        String?
  // 字段定义数组 JSON：[{ id, apiName, name, type, config, ... }]
  fields      Json     @default("[]")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  views       View[]
  records     Record[]

  @@unique([appId, apiName])
  @@index([tenantId])
  @@index([appId])
  @@map("object_metas")
}

model View {
  id        String   @id @default(cuid())
  objectId  String   @map("object_id")
  name      String
  type      String // LIST | DETAIL | FORM
  // 视图配置 JSON：筛选/排序/分组/字段显隐/表单布局
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  object ObjectMeta @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([objectId])
  @@map("views")
}

/// JSONB 宽表：所有对象的业务记录统一存此表。
/// data 列存完整记录字段值，按 object_id 区分归属。
model Record {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  appId     String   @map("app_id")
  objectId  String   @map("object_id")
  // R1.4 多环境：运行数据按环境隔离（值域 'dev'|'prod'，存量 backfill='prod'）
  environmentId String @default("prod") @map("environment_id")
  // 业务数据 JSONB：{ "field_api_name": value, ... }
  data      Json     @default("{}")
  // 创建/更新审计（记录级，data 内不重复存）
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  object      ObjectMeta  @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([appId])
  @@index([objectId])
  @@index([environmentId])
  @@index([tenantId, objectId])
  @@index([appId, objectId])
  // GIN 索引加速 JSONB data 字段查询（Prisma 5.1+ 支持 type: Gin）
  @@index([data], type: Gin)
  @@map("records")
}

// ============================================================================
// 三、页面搭建器（元数据 Schema 存储）
// ============================================================================

model PageMeta {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  appId       String   @map("app_id")
  // 页面可关联对象（列表/详情/表单页），自定义页可为空
  objectId    String?  @map("object_id")
  apiName     String   @map("api_name")
  name        String
  type        String // LIST | DETAIL | FORM | DASHBOARD | CUSTOM
  // 页面 Schema JSON：组件树 + 视图模型 + 绑定关系
  schema      Json     @default("{}")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application     @relation(fields: [appId], references: [id], onDelete: Cascade)
  savePoints  PageSavePoint[]

  @@unique([appId, apiName])
  @@index([tenantId])
  @@index([appId])
  @@map("page_metas")
}

// 页面保存点（E2-4 飞书式历史）：每次保存 Schema 自动快照，保留最近 N 条
model PageSavePoint {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  pageId    String   @map("page_id")
  schema    Json     @default("{}")
  // save = 保存时自动捕获；restore = 历史恢复产生的回滚点
  source    String   @default("save")
  createdBy String   @default("system") @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  page   PageMeta @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([pageId, createdAt(sort: Desc)])
  @@map("page_save_points")
}

// ============================================================================
// 四、流程引擎（自研：WorkflowSchema 为 SSOT）
// ============================================================================

model ProcessDef {
  id             String           @id @default(cuid())
  tenantId       String           @map("tenant_id")
  appId          String           @map("app_id")
  apiName        String           @map("api_name")
  name           String
  // ★ 核心：WorkflowSchema JSON（节点图 + 边），自研引擎直接消费
  workflowSchema Json             @default("{}") @map("workflow_schema")
  version        Int              @default(1)
  status         ProcessDefStatus @default(DRAFT)
  triggerType    String?          @map("trigger_type") // RECORD_CREATED | RECORD_UPDATED | RECORD_DELETED | SCHEDULED | MANUAL | API | BUTTON_CLICK
  cron           String? // Cron 表达式（仅 triggerType=SCHEDULED 时使用）
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application       @relation(fields: [appId], references: [id], onDelete: Cascade)
  instances   ProcessInstance[]

  @@unique([appId, apiName, version])
  @@index([tenantId])
  @@index([appId])
  @@map("process_definitions")
}

enum ProcessDefStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ProcessInstance {
  id             String                @id @default(cuid())
  tenantId       String                @map("tenant_id")
  // R1.4 多环境：实例归属环境 + 启动时冻结的流程 schema（版本切换不影响在途实例）
  environmentId  String                @default("prod") @map("environment_id")
  frozenWorkflowSchema Json?           @map("frozen_workflow_schema")
  processDefId   String                @map("process_def_id")
  // 触发上下文 JSON：触发记录 ID / 触发用户 / 输入参数
  triggerContext Json                  @default("{}") @map("trigger_context")
  // 流程变量快照 JSON：执行中的完整变量作用域
  variables      Json                  @default("{}")
  status         ProcessInstanceStatus @default(RUNNING)
  // 当前活跃节点 ID 列表（token 位置）
  activeNodeIds  String[]              @default([]) @map("active_node_ids")
  startedAt      DateTime              @default(now()) @map("started_at")
  finishedAt     DateTime?             @map("finished_at")
  error          String?

  processDef     ProcessDef      @relation(fields: [processDefId], references: [id], onDelete: Cascade)
  nodeExecutions NodeExecution[]
  tasks          ProcessTask[]

  @@index([tenantId])
  @@index([processDefId])
  @@index([environmentId])
  @@index([status])
  @@map("process_instances")
}

enum ProcessInstanceStatus {
  RUNNING
  WAITING_USER_TASK
  COMPLETED
  FAILED
  TERMINATED
}

model NodeExecution {
  id         String         @id @default(cuid())
  instanceId String         @map("instance_id")
  // R1.4 多环境：冗余实例环境便于直接过滤（随实例 backfill）
  environmentId String      @default("prod") @map("environment_id")
  nodeId     String         @map("node_id") // WorkflowSchema 中的节点 ID
  nodeType   String         @map("node_type")
  status     NodeExecStatus @default(PENDING)
  // 节点输入/输出 JSON
  input      Json?
  output     Json?
  startedAt  DateTime?      @map("started_at")
  finishedAt DateTime?      @map("finished_at")
  error      String?
  retries    Int            @default(0)

  instance ProcessInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@index([nodeId])
  @@index([environmentId])
  @@map("node_executions")
}

enum NodeExecStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
  WAITING
}

// ============================================================================
// 五、流程引擎 — 人工任务 / 通知模版（Phase 3 执行内核）
// ============================================================================

/// 人工任务（UserTask 运行时实例）。
/// NodeExecution 记录节点执行，人工任务独立承载受理人/决策/表单/转办。
model ProcessTask {
  id              String     @id @default(cuid())
  tenantId        String     @map("tenant_id")
  instanceId      String     @map("instance_id")
  nodeExecutionId String     @map("node_execution_id")
  nodeId          String     @map("node_id")
  taskName        String     @map("task_name")
  assignee        String? // 受理人ID
  candidateGroups String[] // 候选组(角色ID)
  status          TaskStatus @default(PENDING)
  decision        String? // approved/rejected/delegated
  comment         String? // 审批意见
  formdata        Json? // 表单数据
  delegatedTo     String?    @map("delegated_to")
  createdAt       DateTime   @default(now()) @map("created_at")
  completedAt     DateTime?  @map("completed_at")

  instance ProcessInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([instanceId])
  @@index([assignee])
  @@index([instanceId, status])
  @@map("process_tasks")
}

enum TaskStatus {
  PENDING
  APPROVED
  REJECTED
  DELEGATED
  CANCELLED
}

/// 通知模版（独立于流程，可在多个流程/通知节点复用）。
model NotificationTemplate {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  appId         String   @map("app_id")
  name          String
  channel       String // IN_APP / EMAIL / WEBHOOK
  titleTemplate String   @map("title_template")
  bodyTemplate  String   @map("body_template")
  variables     Json     @default("[]") // 变量定义数组
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([tenantId, appId, name])
  @@index([tenantId])
  @@index([appId])
  @@map("notification_templates")
}

/// 站内消息 — 流程通知节点 in_app 渠道写入，用户在运行时查看。
model InAppMessage {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  appId     String    @map("app_id")
  userId    String    @map("user_id") // 收件人
  title     String
  body      String
  read      Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([userId, read])
  @@map("in_app_messages")
}

// ============================================================================
// 六、应用管理与发布（Phase 9 — 版本快照 / 变更追踪 / 预检）
// ============================================================================

/// 应用发布版本 — 每次发布生成一条不可变记录。
model AppVersion {
  id            String           @id @default(cuid())
  tenantId      String           @map("tenant_id")
  appId         String           @map("app_id")
  versionNumber String // 语义化版本号，如 "0.1.0"
  description   String // 更新说明
  snapshot      Json             @default("{}") // 完整应用配置快照 (AppSnapshot JSON)
  changeSet     Json? // 变更清单 (ChangeSet JSON)，首次发布为 null
  status        AppVersionStatus @default(PUBLISHED)
  publishedBy   String           @map("published_by")
  publishedAt   DateTime         @default(now()) @map("published_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, versionNumber])
  @@index([tenantId])
  @@index([appId])
  @@map("app_versions")
}

enum AppVersionStatus {
  PUBLISHED
  ROLLED_BACK
}

/// 资源级提交快照（R1.2 版本模型 G1）— 对象/页面/流程统一的 草稿→提交→发布 三态载体。
/// AI（MCP）提交一律 PENDING 待人审；人工提交即时 APPROVED 作为基线快照
/// （供历史版本链 / diff 基线 / 撤销未提交）。应用级发布仍走 AppVersion。
model ResourceVersion {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  appId            String   @map("app_id")
  module           String // OBJECT | PAGE | PROCESS
  // 提交时目标资源可能尚不存在（AI 新建资源待批后才落活表），批准后回填
  entityId         String?  @map("entity_id")
  apiName          String // 资源标识（新建提交的资源链锚点）
  name             String // 冗余展示名
  versionNumber    Int      @map("version_number") // 同资源链内自增
  // 完整资源定义快照：OBJECT=业务字段 / PAGE=schema+元信息 / PROCESS=workflowSchema+触发配置
  snapshot         Json
  status           ResourceVersionStatus @default(PENDING)
  source           ResourceVersionSource @default(HUMAN)
  submittedBy      String   @map("submitted_by")
  submittedVia     String   @default("studio") @map("submitted_via") // studio | mcp
  // diff 基线（上一 approved 版本），版本谱系钩子（R1.4 hotfix 谱系复用）
  baselineVersionId String? @map("baseline_version_id")
  reviewedBy       String?  @map("reviewed_by")
  reviewedAt       DateTime? @map("reviewed_at")
  reviewComment    String?  @map("review_comment")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, module, apiName, versionNumber])
  @@index([tenantId])
  @@index([appId, module, entityId])
  @@index([appId, status])
  @@map("resource_versions")
}

enum ResourceVersionStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ResourceVersionSource {
  HUMAN
  AI_MCP
}

/// 开发态变更追踪 — 记录每次开发态操作（创建/更新/删除）。
model ChangeLog {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  appId             String   @map("app_id")
  module            String // PAGE | OBJECT | PROCESS | PERMISSION
  entityType        String // ObjectMeta | PageMeta | ProcessDef | Role
  entityId          String   @map("entity_id")
  entityName        String?  @map("entity_name")
  changeType        String // CREATE | UPDATE | DELETE
  changedBy         String   @map("changed_by")
  changeDescription String?  @map("change_description")
  changedAt         DateTime @default(now()) @map("changed_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([appId])
  @@index([appId, module])
  @@map("change_logs")
}

/// 应用预检记录 — 记录每次预检的结果。
model AppCheck {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  appId     String   @map("app_id")
  result    String // PASS | FAIL
  issues    Json? // 问题列表 JSON
  checkedBy String   @map("checked_by")
  checkedAt DateTime @default(now()) @map("checked_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([appId])
  @@map("app_checks")
}

// ============================================================================
// 五·连接器 (Connector) — 可复用的外部 API 调用配置
// ============================================================================

/// 连接器 — 可复用的外部 API 调用配置（HTTP 出站 / Webhook 入站）。
model Connector {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  appId        String   @map("app_id")
  apiName      String   @map("api_name") // 应用内唯一标识
  name         String // 显示名称
  description  String?
  type         String // HTTP | WEBHOOK
  baseUrl      String?  @map("base_url") // HTTP 类型的基础 URL
  config       Json     @default("{}") // 类型特定配置（操作定义/默认 headers 等）
  credentialId String?  @map("credential_id") // 关联凭证（可选）
  status       String   @default("ACTIVE") // ACTIVE | INACTIVE
  // Webhook 专用：生成的入站 token（用于验证请求合法性）
  webhookToken String?  @unique @map("webhook_token")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  app        Application          @relation(fields: [appId], references: [id], onDelete: Cascade)
  credential ConnectorCredential? @relation(fields: [credentialId], references: [id])

  @@unique([tenantId, appId, apiName])
  @@index([tenantId])
  @@index([appId])
  @@map("connectors")
}

/// 连接器凭证 — 独立管理，可被多个连接器引用。
model ConnectorCredential {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  appId     String   @map("app_id")
  name      String // 显示名称（如"生产环境 API Key"）
  type      String // BASIC | API_KEY | BEARER
  data      Json     @default("{}") // 加密存储的凭证数据
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  connectors Connector[]

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  app    Application @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([tenantId, appId, name])
  @@index([tenantId])
  @@index([appId])
  @@map("connector_credentials")
}

// ============================================================================
// 六·数据集与数据流 (Dataset & DataFlow) — 物化数据 + 数据变换 pipeline
// ============================================================================

/// 数据流 — 数据变换 pipeline 定义（数据源 → 筛选 → 关联 → 分组汇总 → 输出）。
model DataFlow {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  appId         String   @map("app_id")
  apiName       String   @map("api_name")
  name          String
  description   String?
  /// 数据流配置（JSON pipeline 定义）
  config        Json     @default("{}")
  /// 输出数据集的列定义（执行后自动生成）
  outputColumns Json?
  status        String   @default("DRAFT") // DRAFT | ACTIVE
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  datasets Dataset[]

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  app    Application @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([tenantId, appId, apiName])
  @@index([tenantId])
  @@index([appId])
  @@map("data_flows")
}

/// 数据集 — 由数据流生成的物化数据。
model Dataset {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  appId           String    @map("app_id")
  apiName         String    @map("api_name")
  name            String
  description     String?
  sourceFlowId    String    @map("source_flow_id")
  status          String    @default("EMPTY") // EMPTY | REFRESHING | READY | FAILED
  rowCount        Int       @default(0) @map("row_count")
  columns         Json      @default("[]") // 列定义 [{ apiName, label, type, source }]
  lastRefreshedAt DateTime? @map("last_refreshed_at")
  lastError       String?   @map("last_error")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  app        Application  @relation(fields: [appId], references: [id], onDelete: Cascade)
  sourceFlow DataFlow     @relation(fields: [sourceFlowId], references: [id], onDelete: Cascade)
  rows       DatasetRow[]

  @@unique([tenantId, appId, apiName])
  @@index([tenantId])
  @@index([appId])
  @@map("datasets")
}

/// 数据集行 — 物化数据行（JSONB 宽表模式）。
model DatasetRow {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  datasetId String   @map("dataset_id")
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([datasetId])
  @@index([data], type: Gin)
  @@map("dataset_rows")
}

/// 云函数 — 用户自定义 JavaScript 代码，在 isolated-vm 沙箱中执行。
model CloudFunction {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  appId       String   @map("app_id")
  apiName     String   @map("api_name")
  name        String
  description String?
  code        Json     @default("{\"source\":\"\",\"language\":\"javascript\"}")
  inputSchema Json?
  status      String   @default("DRAFT")
  version     Int      @default(0)
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  app     Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  creator User        @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([tenantId, appId, apiName])
  @@index([tenantId])
  @@index([appId])
  @@map("cloud_functions")
}

/// 自动编号计数器 — 按 (objectId, prefix, environmentId) 原子自增，替代全表扫描计数（并发安全）。
/// R1.4：dev/prod 序列独立。
model AutoNumberCounter {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  objectId  String   @map("object_id")
  prefix    String
  environmentId String @default("prod") @map("environment_id")
  counter   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([objectId, prefix, environmentId])
  @@index([tenantId])
  @@map("auto_number_counters")
}

// ============================================================================
// 十一、多环境（R1.4）—— 环境指针 / 发布历史 / 应用环境变量
// ============================================================================

/// 应用环境（R1.4）：dev | prod（可扩展 staging）。发布=切 currentVersionId 指针。
model AppEnvironment {
  id               String  @id @default(cuid())
  tenantId         String  @map("tenant_id")
  appId            String  @map("app_id")
  key              String // 'dev' | 'prod'
  currentVersionId String? @map("current_version_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application    @relation(fields: [appId], references: [id], onDelete: Cascade)
  deployments Deployment[]
  envVarValues EnvVarValue[]

  @@unique([appId, key])
  @@index([tenantId])
  @@map("app_environments")
}

/// 发布历史（R1.4）：deploy | rollback，记录谁在何时把哪个版本切到哪个环境。
model Deployment {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  appId         String   @map("app_id")
  environmentId String   @map("environment_id") // AppEnvironment.id
  versionId     String   @map("version_id")
  kind          String // deploy | rollback
  operator      String
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application   @relation(fields: [appId], references: [id], onDelete: Cascade)
  environment AppEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([environmentId, createdAt])
  @@index([tenantId])
  @@map("deployments")
}

/// 应用环境变量定义（R1.4 G2 三分类：随环境变的值归此处，构建态一套定义）。
model EnvVarDef {
  id          String  @id @default(cuid())
  tenantId    String  @map("tenant_id")
  appId       String  @map("app_id")
  key         String // 引用名：${env.KEY}
  description String?
  required    Boolean @default(false)
  sensitive   Boolean @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  values EnvVarValue[]

  @@unique([appId, key])
  @@index([tenantId])
  @@map("env_var_defs")
}

/// 环境变量按环境的值（R1.4 G3：敏感值加密落库、写后不可读仅可重置、修改写审计）。
model EnvVarValue {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  environmentId String   @map("environment_id") // AppEnvironment.id
  defId         String   @map("def_id")
  value         String // 敏感值 AES-256-GCM 密文
  updatedBy     String   @map("updated_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  environment AppEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  def         EnvVarDef      @relation(fields: [defId], references: [id], onDelete: Cascade)

  @@unique([environmentId, defId])
  @@index([tenantId])
  @@map("env_var_values")
}
