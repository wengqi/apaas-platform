{
  "name": "@apaas/shared",
  "version": "0.1.0",
  "private": true,
  "description": "跨服务共享类型契约、DTO、表达式引擎——所有 agent 的对接边界",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./object": {
      "types": "./dist/object/index.d.ts",
      "import": "./dist/object/index.js",
      "require": "./dist/object/index.js"
    },
    "./page": {
      "types": "./dist/page/index.d.ts",
      "import": "./dist/page/index.js",
      "require": "./dist/page/index.js"
    },
    "./process": {
      "types": "./dist/process/index.d.ts",
      "import": "./dist/process/index.js",
      "require": "./dist/process/index.js"
    },
    "./permission": {
      "types": "./dist/permission/index.d.ts",
      "import": "./dist/permission/index.js",
      "require": "./dist/permission/index.js"
    },
    "./connector": {
      "types": "./dist/connector/index.d.ts",
      "import": "./dist/connector/index.js",
      "require": "./dist/connector/index.js"
    },
    "./dataset": {
      "types": "./dist/dataset/index.d.ts",
      "import": "./dist/dataset/index.js",
      "require": "./dist/dataset/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "import": "./dist/common/index.js",
      "require": "./dist/common/index.js"
    },
    "./stores": {
      "types": "./dist/stores/index.d.ts",
      "import": "./dist/stores/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-grid-layout": "1.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "dependencies": {
    "@flowgram.ai/fixed-drag-plugin": "^1.0.12",
    "@flowgram.ai/fixed-history-plugin": "^1.0.12",
    "@flowgram.ai/fixed-layout-core": "^1.0.12",
    "@flowgram.ai/fixed-layout-editor": "^1.0.12",
    "react-grid-layout": "^1.5.0"
  },
  "peerDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@tanstack/react-query": "^5.0.0",
    "antd": "^5.0.0",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "react": "^18.0.0",
    "zustand": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@ant-design/icons": {
      "optional": false
    },
    "@tanstack/react-query": {
      "optional": false
    },
    "antd": {
      "optional": false
    },
    "dayjs": {
      "optional": false
    },
    "echarts": {
      "optional": false
    },
    "echarts-for-react": {
      "optional": false
    },
    "react": {
      "optional": false
    },
    "zustand": {
      "optional": false
    }
  }
}
