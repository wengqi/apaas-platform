{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_SECRET",
    "JWT_EXPIRES_IN",
    "GATEWAY_PORT",
    "META_SVC_PORT",
    "RUNTIME_SVC_PORT",
    "PROCESS_SVC_PORT",
    "VITE_STUDIO_PORT",
    "VITE_RUNTIME_PORT",
    "VITE_API_BASE_URL",
    "THROTTLE_TTL_MS",
    "THROTTLE_DEFAULT_LIMIT",
    "THROTTLE_AUTH_LIMIT",
    "BATCH_MAX_ROWS",
    "IMPORT_MAX_ROWS",
    "IMPORT_FILE_MAX_SIZE_MB",
    "CLOUD_FUNCTION_MEMORY_LIMIT_MB",
    "CLOUD_FUNCTION_TIMEOUT_MS",
    "CONNECTOR_ENCRYPTION_KEY",
    "LOG_LEVEL",
    "CORS_ORIGINS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "generate": {
      "dependsOn": ["^generate"],
      "outputs": ["node_modules/.prisma/**", "prisma/generated/**"]
    }
  }
}
